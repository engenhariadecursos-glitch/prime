{
  "expo": {
    "name": "Prime Jejum & Fitness",
    "slug": "prime-fasting-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0F",
    "primaryColor": "#C9A84C",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0A0A0F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.prime.fastingapp",
      "buildNumber": "1",
      "requireFullScreen": true,
      "infoPlist": {
        "NSUserNotificationUsageDescription": "Usamos notificações para lembretes de hidratação, marcos do jejum e motivação diária.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "SKAdNetworkItems": []
      },
      "entitlements": {
        "com.apple.developer.in-app-payments": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.prime.fastingapp",
      "versionCode": 1,
      "compileSdkVersion": 34,
      "targetSdkVersion": 34,
      "minSdkVersion": 24,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ],
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "notification": {
      "icon": "./assets/adaptive-icon.png",
      "color": "#C9A84C",
      "androidMode": "default",
      "androidCollapsedTitle": "Prime Jejum & Fitness"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#C9A84C",
          "defaultChannel": "prime",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0F",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "prime-fasting-app"
      }
    },
    "owner": "engenhariadecursos"
  }
}
